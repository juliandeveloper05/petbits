; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes in []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PetBits"
config/description="Criaturas de datos. Cada mascota nace de una semilla de 64 bits."
config/version="3.0.0"
config/tags=["tamagotchi", "pokemon", "rpg", "petbits"]
config/icon="res://assets/icon.png"
run/main_scene="res://scenes/world/World.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="PetBits"

[audio]

default_bus_layout="res://assets/audio/default_bus_layout.tres"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/resizable=true
window/size/mode=0
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/handheld/orientation="portrait"

[editor]

version_control/plugin_name="GitAPI"

[gdextension]

; GDExtension principal — lógica del juego en C++
extensions=["res://bin/petbits_core.gdextension"]

[importer_defaults]

texture={
"compress/channel_pack": 0,
"compress/hdr_compression": 1,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d/compress_to": 1,
"mipmaps/generate": false,
"mipmaps/limit": -1,
"process/fix_alpha_border": true,
"process/hdr_as_srgb": false,
"process/hdr_clamp_exposure": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"process/size_limit": 0,
"roughness/mode": 0,
"roughness/src_normal": ""
}

[input]

; Acciones del juego
