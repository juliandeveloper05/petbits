#!/usr/bin/env python
# -*- coding: utf-8 -*-
"""
SConstruct — build de la GDExtension de PetBits.

Uso:
  scons                          # template_debug, plataforma local
  scons target=template_release  # release
  scons platform=android arch=arm64

Requiere SCons, un compilador C++17 y el submódulo godot-cpp inicializado.
El README tiene el paso a paso de instalación.

---

NOTA SOBRE LOS TESTS DE PARIDAD: no se construyen desde acá.

Los módulos portados (genome, traits, evolution) son C++ puro: no incluyen un
solo header de Godot. Atarlos a este build obligaría a tener toda la cadena
—SCons, godot-cpp compilado, el editor— instalada antes de poder correr un
test que no la necesita.

Se compilan con un solo comando, sin dependencias. Ver gdext/tests/README.md.
"""

import os
import sys

# ---------------------------------------------------------------------------
# godot-cpp
# ---------------------------------------------------------------------------
# Vale la pena chequearlo a mano: sin esto SCons tira un stack trace de Python
# sobre un archivo que no existe, y el error real —"faltó clonar el submódulo"—
# no aparece por ningún lado.
if not os.path.isfile(os.path.join("godot-cpp", "SConstruct")):
    print("\n  ERROR: falta godot-cpp.\n")
    print("  Es un submódulo de git y todavía no está clonado. Desde la raíz")
    print("  del repo:\n")
    print("      git submodule update --init --recursive\n")
    Exit(1)

env = SConscript("godot-cpp/SConstruct")

# El estándar C++17 NO se declara acá: godot-cpp ya lo hace en
# tools/common_compiler_flags.py, y encima con la sintaxis correcta de cada
# compilador (`/std:c++17` en MSVC, `-std=c++17` en GCC y Clang). Ponerlo a
# mano en formato GNU hacía que MSVC lo descartara con un warning D9002.

# Warnings. MSVC no entiende la familia -W de GCC; su equivalente es /W4.
if env.get("is_msvc", False):
    env.Append(CXXFLAGS=["/W4"])
else:
    env.Append(CXXFLAGS=["-Wall", "-Wextra", "-Wpedantic", "-Wno-unused-parameter"])

# ---------------------------------------------------------------------------
# Salida
# ---------------------------------------------------------------------------
# `env["suffix"]` lo expone godot-cpp justamente para esto: vale
# ".windows.template_debug.x86_64" y ya contempla las variantes (.dev, .double,
# .simulator) que armar el nombre a mano se olvidaría.
#
# El nombre resultante tiene que coincidir EXACTO con el lado derecho de las
# entradas de godot/bin/petbits_core.gdextension. Si no, Godot no encuentra la
# biblioteca y la extensión simplemente no carga.
library_name = "petbits_core"
salida = "../godot/bin/lib{}{}".format(library_name, env["suffix"])

if env["platform"] == "macos":
    # En macOS Godot espera un bundle .framework, no un .dylib suelto.
    library = env.SharedLibrary(
        "{}.framework/lib{}{}".format(salida, library_name, env["suffix"]),
        source=Glob("src/*.cpp"),
    )
else:
    library = env.SharedLibrary(salida + env["SHLIBSUFFIX"], source=Glob("src/*.cpp"))

Default(library)
