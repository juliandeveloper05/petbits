# Dependencias
node_modules/

# Build
dist/
dist-ssr/
*.local

# PocketBase (legado). El rediseño es local-first: el backend recién vuelve a
# discutirse en la Fase 6, y probablemente con Supabase en vez de PocketBase.
backend/pocketbase.exe
backend/pocketbase
backend/pb_data/
backend/*.zip

# Archivos del propio PocketBase, que vienen dentro de su zip. No son del
# proyecto: el CHANGELOG es el de PocketBase y la licencia es de su autor.
backend/CHANGELOG.md
backend/LICENSE.md

# Migraciones autogeneradas del esquema viejo (profiles, coins). Describen un
# backend que se retira, así que no se versionan. Siguen en disco.
backend/pb_migrations/

# IDE
.vscode/
.idea/
*.code-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Entorno
.env
.env.local
.env.*.local

# Cobertura de tests
coverage/
contact-sheet*.png
formas*.png
.vercel
.env*

# -----------------------------------------------------------------------
# Godot Engine
# -----------------------------------------------------------------------
# Caché generada por el editor (no es código fuente)
godot/.godot/
# Exports de Godot (se distribuyen como Releases en GitHub, no en el repo)
godot/exports/
# Binarios de GDExtension compilados localmente
godot/bin/*.dll
godot/bin/*.so
godot/bin/*.dylib
godot/bin/*.framework/
# MSVC deja estos dos al lado de cada .dll con símbolos exportados. No son la
# biblioteca —son la tabla de exportación y la de importación— pero se
# regeneran en cada build igual que ella.
godot/bin/*.exp
godot/bin/*.lib
# Lo único de godot/bin/ que sí se versiona es el .gdextension, que declara
# dónde buscar la biblioteca en cada plataforma, con su .uid al lado.
!godot/bin/*.gdextension
!godot/bin/*.uid

# Los .uid de Godot 4.4+ SÍ van al repo, aunque parezcan generados. Son la
# identidad estable de cada recurso: las escenas referencian por uid, no por
# ruta, para sobrevivir a que un archivo se mueva. Si falta el .uid, Godot
# inventa uno nuevo al abrir y esas referencias quedan colgando.

# -----------------------------------------------------------------------
# GDExtension C++ (gdext/)
# -----------------------------------------------------------------------
# Artefactos de SCons
gdext/.sconsign.dblite
gdext/.sconsign*
gdext/.cache/
# Objetos compilados
gdext/**/*.o
gdext/**/*.obj
gdext/**/*.d
# Binarios de tests
gdext/tests/run_tests
gdext/tests/run_tests.exe
# godot-cpp se incluye como submódulo — sus builds van aquí:
gdext/godot-cpp/.sconsign*

# -----------------------------------------------------------------------
# Python (tools/)
# -----------------------------------------------------------------------
__pycache__/
*.pyc
*.pyo
tools/__pycache__/

# -----------------------------------------------------------------------
# Android build
# -----------------------------------------------------------------------
android/.gradle/
android/build/

# -----------------------------------------------------------------------
# Sprites generados (se regeneran desde seeds, no se versionan)
# -----------------------------------------------------------------------
godot/assets/sprites/*.png

# La hoja de contacto se regenera con un comando; no tiene sentido versionarla.
godot/hoja_de_contacto.png

# -----------------------------------------------------------------------
# CMake — el proyecto para trabajar el núcleo en Visual Studio 2022
# -----------------------------------------------------------------------
# CMakeLists.txt y CMakePresets.json SÍ se versionan: son la configuración.
# Lo que sigue es lo que se genera al compilar.
gdext/build/
gdext/out/
gdext/.vs/
gdext/CMakeUserPresets.json
# Todo lo que deja el compilador al lado de los tests. Antes el ejecutable se
# construía acá; ahora va a gdext/build/, pero alguien puede seguir compilando a
# mano con el comando `cl` que documenta el README y eso sigue dejando restos.
gdext/tests/run_tests
gdext/tests/*.exe
gdext/tests/*.obj
gdext/tests/*.pdb
gdext/tests/*.ilk
gdext/tests/*.manifest

# El save que produce escribir_save.exe para el chequeo de interoperabilidad.
gdext/tests/save_del_cpp.json

# Saves exportados del navegador para probar la interoperabilidad. Son partidas
# personales, no código: quedan en el disco de cada uno y no en el repo.
partida-web.json
partida*.json
