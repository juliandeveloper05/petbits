{
  "name": "petbits",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Criaturas de datos: cada mascota nace de una semilla de 64 bits",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sheet": "vite-node scripts/contactSheet.ts",
    "simular": "vite-node scripts/simular.ts",
    "lint": "biome check src test",
    "format": "biome format --write src test"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "idb-keyval": "^6.3.0",
    "zod": "^4.4.3"
  }
}
